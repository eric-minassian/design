{
  "name": "@eric-minassian/design",
  "version": "0.2.0",
  "private": true,
  "description": "Eric Minassian's design system: shadcn on Base UI, in the design language of T3 Code.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./utils": "./src/lib/utils.ts",
    "./theme": "./src/lib/theme.tsx",
    "./use-mobile": "./src/hooks/use-mobile.ts",
    "./use-highlighted-code": "./src/hooks/use-highlighted-code.ts",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "tsdown",
    "build:site": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-release.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.16.1",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
