{
  "name": "@eric-minassian/design",
  "version": "0.3.0",
  "description": "Eric Minassian's design system: shadcn on Base UI, in the design language of T3 Code.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": "github:eric-minassian/design",
  "exports": {
    "./styles.css": "./dist/styles/index.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./theme": {
      "types": "./dist/lib/theme.d.ts",
      "default": "./dist/lib/theme.js"
    },
    "./use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./use-highlighted-code": {
      "types": "./dist/hooks/use-highlighted-code.d.ts",
      "default": "./dist/hooks/use-highlighted-code.js"
    },
    "./DESIGN.md": "./DESIGN.md",
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.16.1",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
